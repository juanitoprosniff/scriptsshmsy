#!/bin/bash
# menu - Menu principal MSYVPN (plano, sin colores)
source /etc/msyvpn/lib.sh
source /etc/msyvpn/proxy.sh
source /etc/msyvpn/users.sh      # arrastra v2ray.sh y hysteria.sh
source /etc/msyvpn/slowdns.sh

need_root

estado() {
    clear
    title "ESTADO DEL SISTEMA"
    echo "IP        : $(get_ip)"
    echo "Sistema   : Ubuntu/Debian $(os_ver)  ($(arch))"
    echo "RAM       : $(free -m | awk '/Mem:/{print $3"/"$2" MB"}')"
    echo "Carga CPU : $(uptime | awk -F'load average:' '{print $2}')"
    line
    proxy_status
    svc_active v2ray            && echo "V2Ray         : activo"
    svc_active msyvpn-slowdns   && echo "SlowDNS       : activo"
    svc_active msyvpn-hysteria  && echo "Hysteria      : activo"
    line
    echo "Cuentas   : $(wc -l < "$USERS_DB" 2>/dev/null || echo 0)"
    line
}

while true; do
    clear
    title "MSYVPN  -  PANEL VPN"
    echo "IP: $(get_ip)   |   'menu' para volver aqui"
    line
    echo "  1) Usuarios / Cuentas"
    echo "  2) Proxy / SSL   (HAProxy + wsproxy)"
    echo "  3) V2Ray         (VLESS/VMess/Trojan)"
    echo "  4) SlowDNS       (tunel DNS)"
    echo "  5) UDP Hysteria  (juegos/streaming)"
    echo "  6) Estado del sistema"
    echo "  0) Salir"
    line
    case "$(ask 'Opcion: ')" in
        1) u_menu ;;
        2) proxy_menu ;;
        3) v2_menu ;;
        4) sd_menu ;;
        5) hy_menu ;;
        6) estado; pause ;;
        0) clear; exit 0 ;;
    esac
done
