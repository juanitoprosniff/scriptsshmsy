#!/bin/bash
# menu - Menu principal MSYVPN (plano, sin colores)
source /etc/msyvpn/lib.sh
source /etc/msyvpn/proxy.sh
source /etc/msyvpn/users.sh      # arrastra v2ray.sh y hysteria.sh
source /etc/msyvpn/slowdns.sh
source /etc/msyvpn/monitor.sh
source /etc/msyvpn/update.sh

need_root

estado() {
    clear
    title "ESTADO DEL SISTEMA"
    echo "IP        : $(get_ip)"
    echo "Sistema   : Ubuntu/Debian $(os_ver)  ($(arch))"
    echo "RAM       : $(free -m | awk '/Mem:/{print $3"/"$2" MB"}')"
    echo "Swap      : $(mon_swap)"
    echo "Disco     : $(df -h / | awk 'NR==2{print $3"/"$2"  ("$5" usado)"}')"
    echo "Carga CPU : $(uptime | awk -F'load average:' '{print $2}')"
    line
    proxy_status
    svc_active xray              && echo "Xray (V2Ray)  : activo"
    svc_active msyvpn-slowdns    && echo "SlowDNS       : activo"
    svc_active msyvpn-hysteria1  && echo "Hysteria v1   : activo"
    svc_active msyvpn-hysteria2  && echo "Hysteria v2   : activo"
    line
    echo "Cuentas   : $(wc -l < "$USERS_DB" 2>/dev/null || echo 0)"
    echo "Online    : SSH $(mon_ssh)  ·  V2Ray $(mon_v2ray)  ·  UDP $(mon_udp)"
    line
}

while true; do
    clear
    title "MSYVPN $(cat /etc/msyvpn/VERSION 2>/dev/null)  -  PANEL VPN"
    echo "IP: $(get_ip)   |   'menu' para volver aqui"
    line
    echo "  1) Usuarios / Cuentas"
    echo "  2) Proxy / SSL   (HAProxy + wsproxy)"
    echo "  3) V2Ray         (VLESS/VMess/Trojan)"
    echo "  4) SlowDNS       (tunel DNS)"
    echo "  5) UDP Hysteria  (v1 y v2)"
    echo "  6) Monitor y velocidad"
    echo "  7) Estado del sistema"
    echo "  8) Mantenimiento (actualizar / disco)"
    echo "  0) Salir"
    line
    case "$(ask 'Opcion: ')" in
        1) u_menu ;;
        2) proxy_menu ;;
        3) v2_menu ;;
        4) sd_menu ;;
        5) hy_menu ;;
        6) mon_menu ;;
        7) estado; pause ;;
        8) upd_menu ;;
        0) clear; exit 0 ;;
    esac
done
