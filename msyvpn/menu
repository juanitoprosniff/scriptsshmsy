#!/bin/bash
# menu - Menu principal MSYVPN (plano)
source /etc/msyvpn/lib.sh
source /etc/msyvpn/proxy.sh
source /etc/msyvpn/users.sh      # arrastra v2ray.sh y hysteria.sh
source /etc/msyvpn/slowdns.sh
source /etc/msyvpn/shadowsocks.sh
source /etc/msyvpn/wireguard.sh
source /etc/msyvpn/openvpn.sh
source /etc/msyvpn/socks5.sh
source /etc/msyvpn/monitor.sh
source /etc/msyvpn/update.sh

need_root

estado() {
    clear
    title "ESTADO DEL SISTEMA"
    echo "IP        : $(get_ip)"
    echo "Sistema   : Ubuntu/Debian $(os_ver)  ($(arch))   MSYVPN $(cat "$BASE_DIR/VERSION" 2>/dev/null)"
    echo "Uptime    : $(uptime -p 2>/dev/null | sed 's/^up //')"
    line
    mon_cpu
    echo "RAM  : $(mon_ram)"
    echo "Swap : $(mon_swap)"
    echo "Disco: $(df -h / | awk 'NR==2{print $3" de "$2"  ("$5" usado)"}')"
    line
    echo "-- Servicios --"
    printf '  OpenSSH: %s   HAProxy: %s   wsproxy: %s\n' \
        "$(svc_txt ssh sshd)" "$(svc_txt haproxy)" "$(svc_txt msyvpn-wsproxy)"
    printf '  BadVPN: %s   Xray/V2Ray: %s   SlowDNS: %s\n' \
        "$(svc_txt msyvpn-badvpn)" "$(svc_txt xray)" "$(svc_txt msyvpn-slowdns)"
    printf '  Hysteria v1: %s   v2: %s\n' \
        "$(svc_txt msyvpn-hysteria1)" "$(svc_txt msyvpn-hysteria2)"
    printf '  ShadowSocks: %s   WireGuard: %s   OpenVPN: %s\n' \
        "$(svc_txt msyvpn-ss)" "$(svc_txt wg-quick@wg0)" \
        "$(svc_txt msyvpn-ovpn-udp msyvpn-ovpn-tcp0)"
    printf '  SOCKS5: %s\n' "$(svc_txt msyvpn-socks5)"
    line
    echo "-- Usuarios online --"
    printf '  SSH: %s   V2Ray: %s   UDP: %s   (%s)\n' \
        "$(num "$(mon_ssh)")" "$(num "$(mon_v2ray)")" "$(num "$(mon_udp)")" "$(mon_udp_detalle)"
    printf '  ShadowSocks: %s   WireGuard: %s   OpenVPN: %s\n' \
        "$(num "$(mon_ss)")" "$(num "$(mon_wg)")" "$(num "$(mon_ovpn)")"
    printf '  SOCKS5: %s   (%s conexiones)\n' \
        "$(num "$(mon_socks5)")" "$(num "$(mon_socks5_conns)")"
    printf '  Cuentas creadas: %s\n' "$(num "$(wc -l < "$USERS_DB" 2>/dev/null || echo 0)")"
    line
}

# Mostrar solo el estado (lo usa el login de la VPS): menu estado
[[ "$1" == "estado" ]] && { estado; exit 0; }

while true; do
    clear
    title "MSYVPN $(cat "$BASE_DIR/VERSION" 2>/dev/null)  -  PANEL VPN"
    echo "IP: $(get_ip)   |   'menu' para volver aqui"
    line
    echo "  1) Usuarios / Cuentas"
    echo "  2) Proxy / SSL    (SSH + WebSocket)"
    echo "  3) V2Ray          (VLESS/VMess/Trojan)"
    echo "  4) ShadowSocks"
    echo "  5) WireGuard"
    echo "  6) OpenVPN        (UDP + TCP por payload)"
    echo "  7) SlowDNS        (tunel DNS)"
    echo "  8) UDP Hysteria   (v1 y v2)"
    echo "  9) Monitor y velocidad"
    echo " 10) Estado del sistema"
    echo " 11) Mantenimiento  (actualizar / disco / backup)"
    echo " 12) SOCKS5         (mismos puertos y payloads que SSH)"
    echo " 13) Salida IPv4/IPv6  (afecta al pais que ven Google y AdMob)"
    echo "  0) Salir"
    line
    case "$(ask 'Opcion: ')" in
        1)  u_menu ;;
        2)  proxy_menu ;;
        3)  v2_menu ;;
        4)  ss_menu ;;
        5)  wg_menu ;;
        6)  ov_menu ;;
        7)  sd_menu ;;
        8)  hy_menu ;;
        9)  mon_menu ;;
        10) estado; pause ;;
        11) upd_menu ;;
        12) s5_menu ;;
        13) net_pref_menu ;;
        0)  clear; exit 0 ;;
    esac
done
